{
  "trailingComma": "all",
  "printWidth": 80,
  "singleQuote": true,
  "useTabs": false,
  "tabWidth": 2,
  "plugins": [
    "prettier-plugin-organize-imports"
  ],
  "pluginSearchDirs": false,
  "overrides": [
    {
      "files": "*.ts",
      "options": {
        "semi": false
      }
    }
  ],
  "organizeImportsSkipDestructiveCodeActions": true
}
