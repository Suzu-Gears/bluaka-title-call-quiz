---
import Footer from '@/components/Footer.astro'
import Header from '@/components/Header.astro'
import Navigation from '@/components/Navigation.astro'
import CharacterGrid from '@/components/StudentGrid.astro'
import Layout from '@/layouts/Layout.astro'

const sortBy = 'NameSortOrder'
---

<Layout>
  <div class="main" slot="main">
    <Header />
    <div class="content">
      <Navigation />
      <CharacterGrid sortBy={sortBy} />
    </div>
    <Footer />
  </div>
</Layout>

<style>
  .main {
    margin: 0;
    padding: 0;
    background-color: #f4fcfd;
    font-family: sans-serif;
  }

  .content {
    margin: 0 auto;
    padding: 0;
    padding-inline: 1rem;
    width: auto;
    max-width: 1080px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }
</style>
