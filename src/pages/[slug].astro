---
import { copyDirectoryContents, deleteHTMLFiles } from '@/lib/fileOperations'
import { getQuizGeneratorZIP } from '@/lib/getQuizZIP'
import { getQuizOptionsJson } from '@/lib/getSpreadSheetJSON'
import type { QuizParam, QuizParams } from '@/lib/interfaces'
import { makeQuestionText } from '@/lib/makeQuestionText'
import { unzipLocalFile } from '@/lib/unzip'

export interface staticPath {
  params: Pick<QuizParam, 'slug'>
  props: Pick<QuizParam, 'title' | 'description' | 'option'>
}

export async function getStaticPaths() {
  const quizParams: QuizParams = await getQuizOptionsJson()
  const staticPaths: staticPath[] = quizParams.map((quizParam) => ({
    params: {
      slug: quizParam.slug,
    },
    props: {
      title: quizParam.title,
      description: quizParam.description,
      option: quizParam.option,
    },
  }))
  return staticPaths
}

// QuizParamを再構築し、makeQuestionTextを実行
const quizParam: QuizParam = {
  slug: Astro.params.slug,
  title: Astro.props.title,
  description: Astro.props.description,
  option: Astro.props.option,
}

const quizFilePath = await makeQuestionText(quizParam)
console.log(`Created quiz file at ${quizFilePath}`)
const quizGeneratorZIPFilePath = await getQuizGeneratorZIP(quizFilePath)
console.log(`Created quiz generator ZIP file at ${quizGeneratorZIPFilePath}`)
await unzipLocalFile(quizGeneratorZIPFilePath, `tmp/${quizParam.slug}`)
deleteHTMLFiles(`tmp/${quizParam.slug}`)
copyDirectoryContents(`tmp/${quizParam.slug}`, `public/${quizParam.slug}`)
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={Astro.props.description} />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{Astro.props.title}</title>
    <script>
      if ('caches' in window) {
        caches
          .keys()
          .then(function (cacheNames) {
            return Promise.all(
              cacheNames.map(function (cacheName) {
                return caches.delete(cacheName)
              }),
            )
          })
          .then(function () {
            if ('serviceWorker' in navigator) {
              navigator.serviceWorker
                .getRegistrations()
                .then(function (registrations) {
                  // Service Workerを一旦登録解除
                  return Promise.all(
                    registrations.map(function (registration) {
                      // 無関係のService Workerを解除しないようにスコープがassets/内の時のみ実行
                      if (
                        registration.scope.startsWith(
                          `${window.location.origin}/assets/`,
                        )
                      ) {
                        return registration.unregister()
                      }
                    }),
                  )
                })
                .then(function () {
                  navigator.serviceWorker.register(
                    `/${Astro.params.slug}/sw.js`,
                    {
                      scope: `/${Astro.params.slug}/`,
                    },
                  )
                })
            }
          })
      }
    </script>
    <script defer="defer" src={`/${Astro.params.slug}/player-config.js`}
    ></script>
    <script defer="defer" src={`/${Astro.params.slug}/app/player.js`}></script>
  </head>
  <body>
    <div id="root"></div>
    <button class="additional-button back-to-home" onclick="goToHome()"
      >Topへ</button
    >
    <button
      class="additional-button clear-storage"
      onclick="clearLocalStorage()">達成率リセット</button
    >
  </body>
</html>

<style>
  /* ボタンの共通スタイル */
  .additional-button {
    position: fixed;
    right: 20px;
    padding: 13px 24px;
    background-color: rgb(0, 96, 221);
    color: white;
    font-size: 14px;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: background-color 0.3s;
  }
  .additional-button:hover {
    background-color: rgb(18, 62, 190);
  }

  .back-to-home {
    top: 50px;
  }
  .clear-storage {
    top: 100px;
  }
</style>

<script is:inline>
  function checkAndToggleButtons() {
    const pageQuiz = document.querySelector('[data-page="quiz"]')
    const buttons = document.querySelectorAll('.additional-button')

    buttons.forEach((button) => {
      button.style.display = pageQuiz ? 'none' : 'block'
    })
  }

  // 初回チェック
  checkAndToggleButtons()

  // `MutationObserver` を使って `#page_intro` の追加・削除を監視
  const observer = new MutationObserver(() => {
    checkAndToggleButtons()
  })

  // `body` 全体を監視（`childList: true` により子要素の変更を検出）
  observer.observe(document.body, { childList: true, subtree: true })

  function goToHome() {
    window.location.href = '../'
  }
</script>
