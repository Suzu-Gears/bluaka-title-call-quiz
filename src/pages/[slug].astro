---
import Layout from '@/layouts/Layout.astro'
import { getQuizOptionsJson } from '@/lib/getSpreadSheetJSON'
import type { QuizParam, QuizParams } from '@/lib/interfaces'
import { generateQuiz } from '@/lib/quizUtils'

export interface staticPath {
  params: Pick<QuizParam, 'slug'>
  props: Pick<QuizParam, 'title' | 'description' | 'option'>
}

export async function getStaticPaths() {
  const quizParams: QuizParams = await getQuizOptionsJson()
  const staticPaths: staticPath[] = quizParams.map((quizParam) => ({
    params: {
      slug: quizParam.slug,
    },
    props: {
      title: quizParam.title,
      description: quizParam.description,
      option: quizParam.option,
    },
  }))
  return staticPaths
}

const quizParam: QuizParam = {
  slug: Astro.params.slug,
  title: Astro.props.title,
  description: Astro.props.description,
  option: Astro.props.option,
}

await generateQuiz(quizParam)

const title = Astro.props.title
const slug = Astro.params.slug
---

<Layout
  title={Astro.props.title}
  description={Astro.props.description}
  slug={Astro.params.slug}
>
  <Fragment slot="inside-head">
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="robots" content="noindex" />
    <script define:vars={{ title }}>
      function ensureCorrectTitle() {
        const expectedTitle = title
        if (document.title !== expectedTitle) {
          document.title = expectedTitle ?? ''
        }
      }
      const titleObserver = new MutationObserver(ensureCorrectTitle)
      const titleElement = document.querySelector('title')
      if (titleElement) {
        titleObserver.observe(document.head, {
          childList: true,
        })
      }
      ensureCorrectTitle()
    </script>
    <script define:vars={{ slug }}>
      if ('caches' in window) {
        caches
          .keys()
          .then(function (cacheNames) {
            return Promise.all(
              cacheNames.map(function (cacheName) {
                return caches.delete(cacheName)
              }),
            )
          })
          .then(function () {
            if ('serviceWorker' in navigator) {
              navigator.serviceWorker
                .getRegistrations()
                .then(function (registrations) {
                  return Promise.all(
                    registrations.map(function (registration) {
                      if (
                        registration.scope.startsWith(
                          `${window.location.origin}/assets/`,
                        )
                      ) {
                        return registration.unregister()
                      }
                    }),
                  )
                })
                .then(function () {
                  navigator.serviceWorker.register(`/${slug}/sw.js`, {
                    scope: `/${slug}/`,
                  })
                })
            }
          })
      }
    </script>
    <script defer="defer" src={`/${slug}/player-config.js`}></script>
    <script defer="defer" src={`/${slug}/app/player.js`}></script>
  </Fragment>

  <Fragment slot="main" data-title={Astro.props.title} data-slug={slug}>
    <div id="root"></div>
    <button class="additional-button back-to-home" onclick="goToHome()"
      >生徒一覧へ戻る</button
    >
    <button
      class="additional-button clear-storage"
      onclick="clearLocalStorage()">達成率リセット</button
    >
  </Fragment>
</Layout>

<style>
  .additional-button {
    position: fixed;
    right: 20px;
    padding: 13px 24px;
    background-color: rgb(0, 96, 221);
    color: white;
    font-size: 14px;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: background-color 0.3s;
  }
  .additional-button:hover {
    background-color: rgb(18, 62, 190);
  }

  .back-to-home {
    top: 50px;
  }
  .clear-storage {
    top: 100px;
  }
</style>

<script is:inline>
  function checkAndToggleButtons() {
    const pageQuiz = document.querySelector('[data-page="quiz"]')
    const homeButton = document.querySelectorAll('.back-to-home')
    const pageMasterQuiz = document.getElementById('completion-rate-wrapper')
    const clearStorageButton = document.querySelectorAll('.clear-storage')

    homeButton.forEach((button) => {
      button.style.display = pageQuiz ? 'none' : 'block'
    })

    clearStorageButton.forEach((button) => {
      button.style.display = pageMasterQuiz ? 'block' : 'none'
    })
  }

  function getAudioFileName() {
    const questionStatement = document.getElementById('question-statement')
    if (questionStatement) {
      const audioElement = questionStatement.querySelector('audio')
      if (audioElement) {
        const src = audioElement.src
        const fileName = src.substring(
          src.lastIndexOf('/') + 1,
          src.lastIndexOf('.'),
        )
        return decodeURI(fileName)
      }
    }
    return null
  }

  function insertImage(filePath, targetElement) {
    const img = document.createElement('img')
    img.src = filePath
    img.alt = 'Image'
    img.style.width = '100px'
    img.style.aspectRatio = '1/1'
    img.style.objectFit = 'cover'
    img.style.borderRadius = '8px'

    if (targetElement) {
      targetElement.appendChild(img)
    }
  }

  function showAnswerImage() {
    const nextQuestionButton = document.getElementById('next-question-button')
    const showResultButton = document.getElementById('show-result-button')
    const resultPageButton = document.getElementById('result-page-button')

    if (nextQuestionButton || showResultButton || resultPageButton) {
      const fileName = getAudioFileName()
      if (fileName) {
        const targetElement = document.querySelector(
          '[class*="MuiStack-root"][class*="choices-wrapper"]',
        )
        const filePath = `/image/${fileName}.webp`
        if (
          targetElement &&
          !document.querySelector(`img[src="${filePath}"]`)
        ) {
          insertImage(filePath, targetElement)
        }
      }
    }
  }

  function showKokonaStamp() {
    const targetElement = document.querySelector(
      '[class*="MuiTypography-root"][class*="MuiTypography-body"][id="result-message-body"]',
    )
    const scoreElement = document.querySelector(
      '[class*="MuiTypography-root"][class*="MuiTypography-h5"][class*="ResultSummary-score"]',
    )
    const filePath = '/kokona-stamp.png'
    if (
      scoreElement &&
      scoreElement.textContent.trim() === '100' &&
      targetElement &&
      !document.querySelector(`img[src="${filePath}"]`)
    ) {
      insertImage(filePath, targetElement)
    }
  }

  checkAndToggleButtons()

  const observer = new MutationObserver(() => {
    checkAndToggleButtons()
    showAnswerImage()
    showKokonaStamp()
  })

  observer.observe(document.body, { childList: true, subtree: true })

  function goToHome() {
    window.location.href = '../'
  }

  function clearLocalStorage() {
    if (confirm('達成率をリセットしますか？')) {
      localStorage.clear()
      alert('リセットが完了しました。ページを再読み込みします。')
      location.reload()
    }
  }
</script>
