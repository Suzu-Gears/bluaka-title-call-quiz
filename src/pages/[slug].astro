---
import { getQuizOptionsJson } from '@/lib/getSpreadSheetJSON'
import type { QuizParam, QuizParams } from '@/lib/interfaces'

export interface staticPath {
  params: Pick<QuizParam, 'slug'>
  props: Pick<QuizParam, 'title' | 'description'>
}

export async function getStaticPaths() {
  const quizParams: QuizParams = await getQuizOptionsJson()
  const staticPaths: staticPath[] = quizParams.map((quizParam) => ({
    params: {
      slug: quizParam.slug,
    },
    props: {
      title: quizParam.title,
      description: quizParam.description,
    },
  }))
  return staticPaths
}
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>
      {quizParam.title}
    </title>
  </head>
  <body>
    <div>
      {quizParam.title}
    </div>
    <div>
      {quizParam ? quizParam.description : 'No description available'}
    </div>
    <div>
      {Astro.site}
    </div>
  </body>
</html>
