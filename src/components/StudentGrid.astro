---
import '@fontsource/kosugi-maru'

import StudentCard from '@/components/StudentCard.astro'
import type { Student, Students } from '@/lib/interfaces'
import { buildStudentSearchKey } from '@/lib/quizProgress'
import { getStudentsData } from '@/lib/schaleDBClient'

interface Props {
  sortBy?: Extract<
    keyof Student,
    keyof {
      [K in keyof Required<Student> as Required<Student>[K] extends number
        ? K
        : never]: Required<Student>[K]
    }
  >
}

const { sortBy: SortBy = 'DefaultOrder' } = Astro.props as Props

let studentsData: Students = await getStudentsData()

studentsData = studentsData.sort((a, b) => {
  return (a[SortBy] ?? 0) - (b[SortBy] ?? 0)
})
---

<div class="grid" id="studentGrid">
  <label class="search-wrapper" for="student-filter-input">
    フィルター
    <input
      id="student-filter-input"
      class="student-filter-input"
      type="text"
      placeholder="生徒名または衣装名"
      autocomplete="off"
    />
  </label>
  <label class="sort-wrapper" for="student-sort-select">
    並べ替え
    <select id="student-sort-select">
      <option value="default-order">実装順</option>
      <option value="name-order">名前順</option>
    </select>
    <button id="student-sort-direction" class="sort-direction-button" type="button">
      昇順
    </button>
  </label>
  {
    studentsData.length > 0 ? (
      studentsData.map(({ Name, Costume, CharacterVoice, DefaultOrder, NameSortOrder }) => (
        <StudentCard
          name={Name}
          costume={Costume}
          voiceActor={CharacterVoice}
          defaultOrder={DefaultOrder}
          nameSortOrder={NameSortOrder}
          searchKey={buildStudentSearchKey(Name, Costume)}
        />
      ))
    ) : (
      <p>No students available</p>
    )
  }
</div>

<script>
  import { normalizeQuizAnswer } from '@/lib/quizProgress'

  const sortSelect = document.getElementById(
    'student-sort-select',
  ) as HTMLSelectElement | null
  const studentGrid = document.getElementById('studentGrid')
  const filterInput = document.getElementById(
    'student-filter-input',
  ) as HTMLInputElement | null
  const sortDirectionButton = document.getElementById(
    'student-sort-direction',
  ) as HTMLButtonElement | null
  let sortDirection: 'asc' | 'desc' = 'asc'

  const sortCards = (sortMode: string, direction: 'asc' | 'desc') => {
    if (!studentGrid) {
      return
    }
    const cards = [...studentGrid.querySelectorAll('.grid-item')]
    const key =
      sortMode === 'name-order' ? 'nameSortOrder' : 'defaultOrder'
    cards.sort((a, b) => {
      const aValue = Number((a as HTMLElement).dataset[key] ?? 0)
      const bValue = Number((b as HTMLElement).dataset[key] ?? 0)
      return direction === 'asc' ? aValue - bValue : bValue - aValue
    })
    cards.forEach((card) => studentGrid.appendChild(card))
  }

  const filterCards = (rawInput: string) => {
    if (!studentGrid) {
      return
    }
    const normalized = normalizeQuizAnswer(rawInput)
    const cards = [...studentGrid.querySelectorAll('.grid-item')]
    cards.forEach((card) => {
      const cardElement = card as HTMLElement
      const searchKey = String(cardElement.dataset.searchKey ?? '')
      cardElement.style.display =
        !normalized || searchKey.includes(normalized) ? '' : 'none'
    })
  }

  sortSelect?.addEventListener('change', () => {
    sortCards(sortSelect.value, sortDirection)
  })
  sortDirectionButton?.addEventListener('click', () => {
    sortDirection = sortDirection === 'asc' ? 'desc' : 'asc'
    sortDirectionButton.textContent = sortDirection === 'asc' ? '昇順' : '降順'
    if (sortSelect) {
      sortCards(sortSelect.value, sortDirection)
    }
  })
  filterInput?.addEventListener('input', () => {
    filterCards(filterInput.value)
  })
</script>

<style>
  .grid {
    margin-block-start: 1rem;
    display: grid;
    justify-content: center;
    place-items: center;
    width: 100%;
    gap: 8px;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    font-size: 16px;
    font-family: sans-serif;

    /*iPad mini6は193dpi以上で変化    ratio2が対象*/
    @media (min-resolution: 160dpi), (-webkit-min-device-pixel-ratio: 2) {
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 16px;
      font-size: 20px;
      font-family: 'Kosugi Maru', sans-serif;
    }

    /*iPhone13 miniは289dpi以上で変化 ratio2と3の両方が対象？*/
    @media (min-resolution: 250dpi), (-webkit-min-device-pixel-ratio: 3) {
      grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
      gap: 8px;
      font-size: 16px;
      font-family: 'Kosugi Maru', sans-serif;
    }
  }
  .search-wrapper {
    grid-column: 1 / -1;
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9em;
  }
  .student-filter-input {
    min-width: 12rem;
    padding: 0.45rem 0.6rem;
  }
  .sort-wrapper {
    grid-column: 1 / -1;
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9em;
  }
  .sort-direction-button {
    border: 1px solid #1e88e5;
    border-radius: 999px;
    background: #e8f2fe;
    color: #0d5ea8;
    font-size: 0.9em;
    padding: 0.25rem 0.7rem;
    cursor: pointer;
  }
  .sort-direction-button:hover {
    background: #d9ebff;
  }
</style>
