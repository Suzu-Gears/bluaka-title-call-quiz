---
import path from 'node:path'

import { doesFileExist } from '@/lib/fileOperations'
import { getStudentsData } from '@/lib/schaleDBClient'
import { filterCandidates } from '@/lib/quizProgress'

const students = await getStudentsData()
const baseCandidates = students
  .filter(
    ({ Name }) => doesFileExist(path.join('.', 'public/audio'), `${Name}.mp3`),
  )
  .map(({ Name, Costume, IsCollaboration }) => ({
    name: Name,
    costume: Costume ?? '',
    isCollaboration: Boolean(IsCollaboration),
  }))

const normalNames = filterCandidates(baseCandidates, {
  includeNormal: true,
  includeCostume: false,
  includeCollaboration: false,
}).map(({ name }) => name)
const costumeNames = filterCandidates(baseCandidates, {
  includeNormal: false,
  includeCostume: true,
  includeCollaboration: false,
}).map(({ name }) => name)
const collaborationNames = filterCandidates(baseCandidates, {
  includeNormal: false,
  includeCostume: false,
  includeCollaboration: true,
}).map(({ name }) => name)
const allStudentsNames = filterCandidates(baseCandidates, {
  includeNormal: true,
  includeCostume: true,
  includeCollaboration: false,
}).map(({ name }) => name)
const costumeHints = Object.fromEntries(
  baseCandidates.map(({ name, costume }) => [name, costume ?? '']),
)
---

<section
  aria-label="クイズ"
  class="quiz-section"
  data-candidate-groups={JSON.stringify({
    normal: normalNames,
    costume: costumeNames,
    collaboration: collaborationNames,
    allStudents: allStudentsNames,
  })}
  data-costume-hints={JSON.stringify(costumeHints)}
>
  <h2>クイズ</h2>
  <label for="quiz-mode-select">
    出題方式
    <select id="quiz-mode-select">
      <option value="multiple-choice">4択</option>
      <option value="name-input">名前入力</option>
    </select>
  </label>
  <fieldset class="quiz-filter-fieldset">
    <legend>出題対象</legend>
    <label>
      <input id="quiz-filter-normal" type="checkbox" checked />
      通常
    </label>
    <label>
      <input id="quiz-filter-costume" type="checkbox" />
      別衣装
    </label>
    <label>
      <input id="quiz-filter-collaboration" type="checkbox" />
      コラボ生徒
    </label>
  </fieldset>
  <label id="quiz-name-mode-wrapper" for="quiz-name-filter-mode" hidden>
    名前入力の出題対象
    <select id="quiz-name-filter-mode">
      <option value="normal-only">通常生徒のみ</option>
      <option value="all-students">別衣装を含む全生徒</option>
    </select>
  </label>
  <label class="quiz-question-count-wrapper" for="quiz-question-count-preset">
    問題数
    <select id="quiz-question-count-preset">
      <option value="1">1</option>
      <option value="10" selected>10</option>
      <option value="20">20</option>
      <option value="custom">任意</option>
    </select>
    <input
      id="quiz-question-count-custom"
      type="number"
      min="1"
      step="1"
      placeholder="任意"
      hidden
    />
  </label>
  <p id="quiz-status">「開始」を押すとクイズを開始します。</p>
  <div class="quiz-controls">
    <button id="quiz-start-button" type="button">開始</button>
    <button id="quiz-play-audio-button" type="button" disabled>もう一度再生</button>
    <button id="quiz-export-progress-button" type="button">進捗エクスポート</button>
    <button id="quiz-import-progress-button" type="button">進捗インポート</button>
  </div>
  <div class="quiz-choices" id="quiz-choices"></div>
  <form id="quiz-name-answer-form" class="quiz-name-answer-form" hidden>
    <input
      id="quiz-name-answer-input"
      type="text"
      autocomplete="off"
      placeholder="生徒名を入力"
    />
    <button type="submit">回答する</button>
  </form>
  <small id="quiz-costume-hint-text"></small>
  <small id="quiz-proficiency-text"></small>
</section>

<script type="module">
  const STORAGE_KEY = 'bluaka-title-call-quiz2.proficiency.v1'
  const LEGACY_STORAGE_KEYS = [
    'bluaka-title-call-quiz.proficiency.v1',
    'bluaka-title-call-quiz.proficiency',
    'quizProficiency',
  ]

  const quizSection = document.querySelector('.quiz-section')
  const candidateGroups = JSON.parse(
    quizSection?.getAttribute('data-candidate-groups') ?? '{}',
  )
  const costumeHints = JSON.parse(
    quizSection?.getAttribute('data-costume-hints') ?? '{}',
  )

  const quizModeSelect = document.getElementById('quiz-mode-select')
  const normalFilter = document.getElementById('quiz-filter-normal')
  const costumeFilter = document.getElementById('quiz-filter-costume')
  const collaborationFilter = document.getElementById('quiz-filter-collaboration')
  const filterFieldset = document.querySelector('.quiz-filter-fieldset')
  const nameModeWrapper = document.getElementById('quiz-name-mode-wrapper')
  const nameFilterMode = document.getElementById('quiz-name-filter-mode')
  const questionCountPreset = document.getElementById('quiz-question-count-preset')
  const questionCountCustom = document.getElementById('quiz-question-count-custom')

  const getMultipleChoiceCandidates = () => {
    const selected = new Set()
    if (normalFilter?.checked) {
      ;(candidateGroups.normal ?? []).forEach((name) => selected.add(name))
    }
    if (costumeFilter?.checked) {
      ;(candidateGroups.costume ?? []).forEach((name) => selected.add(name))
    }
    if (collaborationFilter?.checked) {
      ;(candidateGroups.collaboration ?? []).forEach((name) => selected.add(name))
    }
    return [...selected]
  }
  const getNameInputCandidates = () => {
    return nameFilterMode?.value === 'all-students'
      ? [...(candidateGroups.allStudents ?? [])]
      : [...(candidateGroups.normal ?? [])]
  }
  const normalizeAnswer = (value) => {
    return String(value ?? '')
      .normalize('NFKC')
      .replace(/\s+/g, '')
      .toLowerCase()
  }

  const shuffleArray = (values) => {
    const next = [...values]
    for (let i = next.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1))
      ;[next[i], next[j]] = [next[j], next[i]]
    }
    return next
  }

  const buildChoices = (correctName, allNames) => {
    const distractors = allNames.filter((name) => name !== correctName)
    const pickedDistractors = shuffleArray(distractors).slice(0, 3)
    return shuffleArray([correctName, ...pickedDistractors])
  }

  const startButton = document.getElementById('quiz-start-button')
  const replayButton = document.getElementById('quiz-play-audio-button')
  const exportButton = document.getElementById('quiz-export-progress-button')
  const importButton = document.getElementById('quiz-import-progress-button')
  const statusText = document.getElementById('quiz-status')
  const proficiencyText = document.getElementById('quiz-proficiency-text')
  const costumeHintText = document.getElementById('quiz-costume-hint-text')
  const choicesRoot = document.getElementById('quiz-choices')
  const nameAnswerForm = document.getElementById('quiz-name-answer-form')
  const nameAnswerInput = document.getElementById('quiz-name-answer-input')
  const nameAnswerSubmit = nameAnswerForm?.querySelector('button[type="submit"]')

  let askedNames = []
  let currentAnswer = ''
  let currentMode = quizModeSelect?.value ?? 'multiple-choice'
  let shouldShowCurrentAnswerStats = false
  let score = 0
  let questionNumber = 0
  let currentAudio = null
  let proficiencyMap = {}
  let activeNames =
    currentMode === 'name-input'
      ? getNameInputCandidates()
      : getMultipleChoiceCandidates()
  let totalQuestions = Math.min(10, activeNames.length)

  const normalizeMap = (rawMap) => {
    const result = {}
    if (!rawMap || typeof rawMap !== 'object') {
      return result
    }
    Object.entries(rawMap).forEach(([name, entry]) => {
      if (!entry || typeof entry !== 'object') {
        return
      }
      const correct = Number(entry.correct)
      const attempts = Number(entry.attempts)
      if (!Number.isFinite(correct) || !Number.isFinite(attempts)) {
        return
      }
      result[name] = {
        correct: Math.max(0, Math.floor(correct)),
        attempts: Math.max(0, Math.floor(attempts)),
      }
    })
    return result
  }

  const migrateLegacyMap = (rawMap) => {
    const normalized = normalizeMap(rawMap)
    if (Object.keys(normalized).length > 0) {
      return normalized
    }
    const result = {}
    if (!rawMap || typeof rawMap !== 'object') {
      return result
    }
    Object.entries(rawMap).forEach(([name, value]) => {
      if (typeof value === 'number' && Number.isFinite(value)) {
        const correct = Math.max(0, Math.floor(value))
        result[name] = { correct, attempts: correct }
      }
    })
    return result
  }

  const ensureStudentEntries = (map) => {
    const next = { ...map }
    Object.values(candidateGroups)
      .flat()
      .forEach((name) => {
        if (!next[name]) {
          next[name] = { correct: 0, attempts: 0 }
        }
      })
    return next
  }

  const saveProficiency = () => {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(proficiencyMap))
  }

  const loadProficiency = () => {
    const currentRaw = localStorage.getItem(STORAGE_KEY)
    if (currentRaw) {
      proficiencyMap = ensureStudentEntries(normalizeMap(JSON.parse(currentRaw)))
      saveProficiency()
      return
    }

    for (const legacyKey of LEGACY_STORAGE_KEYS) {
      const legacyRaw = localStorage.getItem(legacyKey)
      if (!legacyRaw) {
        continue
      }
      proficiencyMap = ensureStudentEntries(
        migrateLegacyMap(JSON.parse(legacyRaw)),
      )
      saveProficiency()
      localStorage.removeItem(legacyKey)
      statusText.textContent = '旧セーブデータを移行しました。'
      return
    }
    proficiencyMap = ensureStudentEntries({})
    saveProficiency()
  }

  const calculateAccuracy = (entry) => {
    if (!entry || entry.attempts <= 0) {
      return 0
    }
    return Math.round((entry.correct / entry.attempts) * 1000) / 10
  }

  const updateProficiencyText = () => {
    const entry = proficiencyMap[currentAnswer]
    const accuracy = calculateAccuracy(entry)
    proficiencyText.textContent = currentAnswer && shouldShowCurrentAnswerStats
      ? `${currentAnswer} の正答率: ${accuracy}% (${entry.correct}/${entry.attempts})`
      : ''
  }

  const recordAnswer = (studentName, isCorrect) => {
    const entry = proficiencyMap[studentName] ?? { correct: 0, attempts: 0 }
    entry.attempts += 1
    if (isCorrect) {
      entry.correct += 1
    }
    proficiencyMap[studentName] = entry
    saveProficiency()
    updateProficiencyText()
  }

  const updateQuestionCountFieldVisibility = () => {
    if (!questionCountCustom) {
      return
    }
    questionCountCustom.hidden = questionCountPreset?.value !== 'custom'
  }

  const getSelectedQuestionCount = (maxQuestions) => {
    if (maxQuestions <= 0) {
      return 0
    }
    const presetValue = questionCountPreset?.value ?? '10'
    const rawValue =
      presetValue === 'custom'
        ? Number(questionCountCustom?.value ?? '')
        : Number(presetValue)
    const parsed = Math.floor(Number(rawValue))
    if (!Number.isFinite(parsed) || parsed < 1) {
      return Math.max(1, Math.min(10, maxQuestions))
    }
    return Math.max(1, Math.min(parsed, maxQuestions))
  }

  const updateModeUI = () => {
    currentMode = quizModeSelect?.value ?? 'multiple-choice'
    const isNameInputMode = currentMode === 'name-input'
    if (filterFieldset) {
      filterFieldset.hidden = isNameInputMode
    }
    if (nameModeWrapper) {
      nameModeWrapper.hidden = !isNameInputMode
    }
    if (isNameInputMode) {
      choicesRoot.hidden = true
      if (nameAnswerForm) {
        nameAnswerForm.hidden = false
      }
    } else {
      choicesRoot.hidden = false
      if (nameAnswerForm) {
        nameAnswerForm.hidden = true
      }
    }
  }

  const updateCostumeHintText = () => {
    if (currentMode !== 'name-input' || !currentAnswer) {
      costumeHintText.textContent = ''
      return
    }
    const costumeName = String(costumeHints[currentAnswer] ?? '').trim()
    costumeHintText.textContent = costumeName
      ? `ヒント: ${costumeName}`
      : ''
  }

  const refreshFilterState = () => {
    activeNames =
      currentMode === 'name-input'
        ? getNameInputCandidates()
        : getMultipleChoiceCandidates()
    totalQuestions = getSelectedQuestionCount(activeNames.length)
  }

  const stopAudio = () => {
    if (currentAudio) {
      currentAudio.pause()
      currentAudio.currentTime = 0
      currentAudio = null
    }
  }

  const playCurrentAudio = () => {
    if (!currentAnswer) {
      return
    }
    if (!activeNames.includes(currentAnswer)) {
      return
    }
    stopAudio()
    currentAudio = new Audio(`/audio/${encodeURIComponent(currentAnswer)}.mp3`)
    currentAudio.play().catch(() => {
      statusText.textContent = '音声を再生できませんでした。もう一度お試しください。'
    })
  }

  const renderQuestion = () => {
    choicesRoot.innerHTML = ''
    const available = activeNames.filter((name) => !askedNames.includes(name))
    if (available.length === 0 || questionNumber >= totalQuestions) {
      stopAudio()
      currentAnswer = ''
      shouldShowCurrentAnswerStats = false
      replayButton.disabled = true
      statusText.textContent = `終了！${score} / ${questionNumber} 問正解`
      startButton.textContent = 'もう一度'
      updateCostumeHintText()
      updateProficiencyText()
      return
    }

    currentAnswer = available[Math.floor(Math.random() * available.length)]
    askedNames.push(currentAnswer)
    questionNumber += 1
    statusText.textContent = `第${questionNumber}問: このタイトルコールは誰？`
    shouldShowCurrentAnswerStats = false
    replayButton.disabled = false
    playCurrentAudio()
    updateCostumeHintText()
    updateProficiencyText()

    if (currentMode === 'multiple-choice') {
      choicesRoot.hidden = false
      if (nameAnswerForm) {
        nameAnswerForm.hidden = true
      }
      const choices = buildChoices(currentAnswer, activeNames)
      choices.forEach((name) => {
        const button = document.createElement('button')
        button.type = 'button'
        button.textContent = name
        button.addEventListener('click', () => {
          const isCorrect = name === currentAnswer
          if (isCorrect) {
            score += 1
          }
          shouldShowCurrentAnswerStats = true
          recordAnswer(currentAnswer, isCorrect)
          statusText.textContent = isCorrect
            ? '正解！'
            : `不正解… 正解は「${currentAnswer}」`
          choicesRoot.querySelectorAll('button').forEach((choiceButton) => {
            choiceButton.disabled = true
            if (choiceButton.textContent === currentAnswer) {
              choiceButton.classList.add('correct')
            }
          })
          setTimeout(renderQuestion, 900)
        })
        choicesRoot.appendChild(button)
      })
      return
    }

    choicesRoot.hidden = true
    if (nameAnswerForm) {
      nameAnswerForm.hidden = false
    }
    if (nameAnswerInput) {
      nameAnswerInput.value = ''
      nameAnswerInput.disabled = false
      nameAnswerInput.focus()
    }
    if (nameAnswerSubmit) {
      nameAnswerSubmit.disabled = false
    }
  }

  startButton?.addEventListener('click', () => {
    updateModeUI()
    updateQuestionCountFieldVisibility()
    refreshFilterState()
    if (activeNames.length < 1) {
      statusText.textContent =
        'クイズを開始できません。選択中の条件で生徒データを1件以上用意してください。'
      return
    }
    if (currentMode === 'multiple-choice' && activeNames.length < 4) {
      statusText.textContent =
        'クイズを開始できません。選択中の条件で生徒データを4件以上用意してください。'
      return
    }
    askedNames = []
    currentAnswer = ''
    score = 0
    questionNumber = 0
    shouldShowCurrentAnswerStats = false
    startButton.textContent = 'リスタート'
    renderQuestion()
  })

  replayButton?.addEventListener('click', playCurrentAudio)
  quizModeSelect?.addEventListener('change', () => {
    updateModeUI()
    refreshFilterState()
    statusText.textContent = '出題方式を変更しました。「開始」を押してください。'
  })
  nameFilterMode?.addEventListener('change', () => {
    refreshFilterState()
    statusText.textContent =
      '名前入力の出題対象を変更しました。「開始」を押してください。'
  })
  questionCountPreset?.addEventListener('change', () => {
    updateQuestionCountFieldVisibility()
    refreshFilterState()
    statusText.textContent = '問題数を変更しました。「開始」を押してください。'
  })
  questionCountCustom?.addEventListener('input', () => {
    refreshFilterState()
  })
  ;[normalFilter, costumeFilter, collaborationFilter].forEach((checkbox) => {
    checkbox?.addEventListener('change', () => {
      refreshFilterState()
      statusText.textContent = '出題対象を変更しました。「開始」を押してください。'
    })
  })
  nameAnswerForm?.addEventListener('submit', (event) => {
    event.preventDefault()
    if (!currentAnswer || !nameAnswerInput || !nameAnswerSubmit) {
      return
    }
    const answer = normalizeAnswer(nameAnswerInput.value)
    const correctAnswer = normalizeAnswer(currentAnswer)
    const isCorrect = answer.length > 0 && answer === correctAnswer
    if (isCorrect) {
      score += 1
    }
    shouldShowCurrentAnswerStats = true
    recordAnswer(currentAnswer, isCorrect)
    statusText.textContent = isCorrect
      ? '正解！'
      : `不正解… 正解は「${currentAnswer}」`
    nameAnswerInput.disabled = true
    nameAnswerSubmit.disabled = true
    setTimeout(renderQuestion, 900)
  })

  exportButton?.addEventListener('click', () => {
    const blob = new Blob([JSON.stringify(proficiencyMap, null, 2)], {
      type: 'application/json',
    })
    const url = URL.createObjectURL(blob)
    const link = document.createElement('a')
    link.href = url
    link.download = 'bluaka-quiz-proficiency.json'
    link.click()
    URL.revokeObjectURL(url)
  })

  importButton?.addEventListener('click', () => {
    const raw = window.prompt(
      '移行するJSONを貼り付けてください（エクスポート済みデータ）',
    )
    if (!raw) {
      return
    }
    try {
      const parsed = JSON.parse(raw)
      const imported = ensureStudentEntries(migrateLegacyMap(parsed))
      proficiencyMap = {
        ...proficiencyMap,
        ...imported,
      }
      saveProficiency()
      statusText.textContent = '進捗データをインポートしました。'
      updateProficiencyText()
    } catch {
      statusText.textContent = 'JSONの解析に失敗しました。形式を確認してください。'
    }
  })

  loadProficiency()
  updateModeUI()
  updateQuestionCountFieldVisibility()
  refreshFilterState()
</script>

<style>
  .quiz-section {
    margin-top: 1rem;
    width: 100%;
    max-width: 720px;
    border: 1px solid #ddd;
    border-radius: 1rem;
    padding: 1rem;
    background: #fff;
  }
  .quiz-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .quiz-filter-fieldset {
    margin: 0;
    border: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .quiz-filter-fieldset label {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .quiz-question-count-wrapper {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    margin-top: 0.5rem;
  }
  .quiz-name-answer-form {
    margin-top: 0.75rem;
    display: flex;
    gap: 0.5rem;
  }
  .quiz-name-answer-form[hidden] {
    display: none;
  }
  #quiz-name-answer-input {
    flex: 1;
    min-width: 0;
    padding: 0.45rem 0.6rem;
  }
  #quiz-costume-hint-text {
    display: block;
    margin-top: 0.5rem;
    color: #444;
  }
  .quiz-choices {
    margin-top: 1rem;
    display: grid;
    gap: 0.5rem;
  }
  button.correct {
    background: #0d9848;
    color: #fff;
  }
  #quiz-proficiency-text {
    display: block;
    margin-top: 0.75rem;
    color: #555;
  }
</style>
