---
import { doesFileExist } from '@/lib/fileOperations'
import path from 'node:path'

const { name, voiceActor } = Astro.props as { name: string; voiceActor: string }

// 全角括弧が含まれている場合、先頭に半角スペースを追加する関数
const formatName = (name: string): string => {
  return name.includes('（') ? '\u00A0' + '\u00A0' + name : name
}

// 音声ファイルが存在するか確認
const audioExists = doesFileExist(path.join('.', 'public/audio'), `${name}.mp3`)
const formattedName = formatName(name) + (audioExists ? '' : '🚫')
---

<div class="grid-item" data-name={name} tabindex="0">
  <div class="image-container">
    <img
      src={doesFileExist(path.join('.', 'public/image'), `${name}.webp`)
        ? `/image/${name}.webp`
        : `/default-student-image.webp`}
      loading="lazy"
      alt={name}
    />
    <div class="voice-actor">CV.{voiceActor}</div>
  </div>
  <div class="name-container">
    <div class="name" id="fit-text">{formattedName}</div>
  </div>
  {
    audioExists && (
      <audio
        id={`audio-${name}`}
        src={`/audio/${name}.mp3`}
        preload="none"
        hidden
      />
    )
  }
</div>

<script>
  import fitty from 'fitty'

  // 指定したセレクタのフォントサイズを取得する関数
  function getFontSize(selector: string) {
    const element = document.querySelector(selector)
    if (element) {
      const style = window.getComputedStyle(element)
      return parseFloat(style.fontSize)
    }
    return 16 // デフォルト値
  }

  // devicePixelRatioの変更を検知してfittyを再設定する関数
  function setupFitty() {
    const maxFontSize = getFontSize('#fit-text') || getFontSize('.name')
    fitty('#fit-text', {
      minSize: 9,
      maxSize: maxFontSize,
      multiLine: true,
    })
  }

  // 初回ロード時にfittyを設定
  document.addEventListener('DOMContentLoaded', () => {
    setupFitty()
  })

  // devicePixelRatioの変更を検知してfittyを再設定
  let devicePixelRatio = window.devicePixelRatio
  window.addEventListener('resize', () => {
    if (window.devicePixelRatio !== devicePixelRatio) {
      devicePixelRatio = window.devicePixelRatio
      setupFitty()
    }
  })
</script>

<script>
  let activeAudioPlayer: HTMLAudioElement | null = null

  function playAudio(name: string) {
    const audioPlayer = document.getElementById(
      `audio-${name}`,
    ) as HTMLAudioElement
    const imgElement = document.querySelector(
      `.grid-item[data-name="${name}"] img`,
    )

    if (activeAudioPlayer && activeAudioPlayer !== audioPlayer) {
      resetAudio(activeAudioPlayer)
    }

    activeAudioPlayer = audioPlayer

    audioPlayer.currentTime = 0
    audioPlayer.play()
    if (imgElement) {
      imgElement.classList.add('playing')
    }

    audioPlayer.onended = () => resetAudio(audioPlayer)
  }

  function resetAudio(audioPlayer: HTMLAudioElement) {
    audioPlayer.pause()
    audioPlayer.currentTime = 0
    const imgElement = document.querySelector(
      `.grid-item[data-name="${audioPlayer.id.replace('audio-', '')}"] img`,
    )
    if (imgElement) {
      imgElement.classList.remove('playing')
    }
    activeAudioPlayer = null
  }

  const gridElement = document.querySelector('.grid')
  if (gridElement) {
    gridElement.addEventListener('click', (e: Event) => {
      const target = e.target as HTMLElement | null
      if (!target) return
      const gridItem = target.closest('.grid-item')
      if (!gridItem) return
      const name = (gridItem as HTMLElement).dataset.name
      if (name) {
        playAudio(name)
      }
    })

    gridElement.addEventListener('keydown', (e: Event) => {
      const event = e as KeyboardEvent
      const target = event.target as HTMLElement | null
      if (!target) return
      if (event.key === 'Enter') {
        const gridItem = target.closest('.grid-item')
        if (!gridItem) return
        const name = (gridItem as HTMLElement).dataset.name
        if (name) {
          playAudio(name)
        }
      }
    })
  }
</script>

<style>
  div {
    padding: 0;
    margin: 0;
  }

  .grid-item {
    margin-block-start: 0.5rem;
    position: relative;
    text-align: center;
    cursor: pointer;
    width: 100%;
    border-radius: 8px;
    outline: none; /* デフォルトのフォーカスアウトラインを無効にする */
  }

  .grid-item:focus-visible {
    outline: 3px solid rgba(0, 123, 255, 0.7); /* フォーカス時のアウトラインを追加 */
    outline-offset: 6px; /* アウトラインを外側にオフセット */
  }

  .image-container {
    position: relative;
    width: 100%;
    height: 0;
    padding-bottom: 110%; /* 1/1.1 のアスペクト比を維持 */
  }

  .voice-actor {
    position: absolute;
    bottom: 0;
    width: 100%;
    height: 18%;
    background-color: rgb(28 42 65 / 70%);
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;

    font-size: 12px;
    font-weight: bold;
    white-space: nowrap;
    font-family: sans-serif;
    color: #ffffff;
  }

  img {
    width: 100%;
    aspect-ratio: 1/1.1;
    object-fit: cover;
    border-radius: 8px;
    transition: transform 0.3s;
    user-select: none;
    user-drag: none;
    -webkit-user-drag: none;
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    -moz-user-select: none;
    -ms-user-select: none;
  }

  img.playing {
    animation: box-shadow-blink 0.6s infinite;
  }

  @keyframes box-shadow-blink {
    0% {
      box-shadow: 0 0 0 6px rgba(0, 123, 255, 0.3);
    }
    50% {
      box-shadow: 0 0 0 6px rgba(0, 123, 255, 0.7);
    }
    100% {
      box-shadow: 0 0 0 6px rgba(0, 123, 255, 0.3);
    }
  }

  @media (hover: hover) {
    .image-container:hover {
      transform: scale(1.05);
    }
  }

  .name-container {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    height: 20px;
  }

  .name {
    white-space: nowrap;
    font-family: sans-serif;
    color: #60676f;
    background: linear-gradient(
      transparent 0% 65%,
      #f9f49b 65% 80%,
      transparent 80% 100%
    );
    font-weight: bold;
  }
</style>
